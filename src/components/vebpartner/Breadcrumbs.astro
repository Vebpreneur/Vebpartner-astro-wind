---
export interface BreadcrumbItem { label: string; href?: string }
export interface Props { items: BreadcrumbItem[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => <li class="flex items-center gap-2">{index > 0 && <span aria-hidden="true">/</span>}{item.href ? <a class="hover:text-primary hover:underline" href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
