---
export interface Props { label: string; url: string; description?: string }
const { label, url, description = 'Verify current details directly with the official provider.' } = Astro.props;
---
<aside class="rounded-2xl border border-primary/20 bg-primary/5 p-5 sm:p-6">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Official source</p>
  <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div><h2 class="text-lg font-bold text-heading">{label}</h2><p class="mt-1 text-sm text-muted">{description}</p></div>
    <a class="btn-primary shrink-0" href={url} target="_blank" rel="noopener noreferrer">Visit official program →</a>
  </div>
</aside>
