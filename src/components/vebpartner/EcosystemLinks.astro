---
export interface EcosystemLink { label: string; href?: string }
export interface Props { links?: EcosystemLink[] }
const { links = [{ label: 'Vebstar' }, { label: 'Anbudly', href: 'https://anbudly.se' }, { label: 'Identry' }] } = Astro.props;
---
<nav aria-label="Vebpartner ecosystem" class="text-xs text-muted"><ul class="flex flex-wrap gap-x-4 gap-y-2">{links.map((link) => <li>{link.href ? <a class="hover:text-primary hover:underline" href={link.href}>{link.label}</a> : <span>{link.label}</span>}</li>)}</ul></nav>
