---
export interface Fact { label: string; value: string }
export interface Props { facts: Fact[] }
const { facts } = Astro.props;
---
<section aria-labelledby="quick-facts-title" class="rounded-2xl border border-gray-200 bg-white/70 p-5 sm:p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
  <h2 id="quick-facts-title" class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-muted">Quick facts</h2>
  <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
    {facts.map(({ label, value }) => <div><dt class="text-xs font-semibold uppercase tracking-wide text-muted">{label}</dt><dd class="mt-1 font-semibold text-heading">{value}</dd></div>)}
  </dl>
</section>
