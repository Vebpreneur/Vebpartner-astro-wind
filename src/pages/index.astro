---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import StructuredData from '~/components/common/StructuredData.astro';

const metadata = {
  title: 'Vebpartner — Discover, Build, Learn and Launch',
  description: 'Vebpartner connects practical business opportunities, technical building blocks, service models, learning paths and useful tools.',
  ignoreTitleTemplate: true,
  canonical: 'https://vebpartner.se/',
};
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://vebpartner.se/#website', name: 'Vebpartner', url: 'https://vebpartner.se/', publisher: { '@id': 'https://vebpartner.se/#organization' } },
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://vebpartner.se/#organization', name: 'Vebpartner', url: 'https://vebpartner.se/' },
];
---
<Layout metadata={metadata}>
  <div slot="announcement"></div>
  <StructuredData slot="head" schema={structuredData} />
  <Hero tagline="Vebpartner" title="Find leverage. Build faster. Own the relationship." subtitle="A growing network of practical opportunities, infrastructure, services, learning paths and tools for building digital businesses." actions={[{ variant: 'primary', text: 'Explore START', href: '/start/' }, { text: 'Browse the network', href: '#network' }]} />
  <Features2 id="network" tagline="The network" title="Five ways to move forward" subtitle="Each area is built from structured, source-backed content and designed to become more useful as the network grows." columns={3} items={[
    { title: 'START', description: 'White-label platforms, reseller models and partner programs.', icon: 'tabler:rocket', href: '/start/' },
    { title: 'BUILD', description: 'APIs, infrastructure and building blocks for digital products.', icon: 'tabler:blocks', href: '/build/' },
    { title: 'SERVICES', description: 'Service models and provider infrastructure for commercial delivery.', icon: 'tabler:briefcase', href: '/services/' },
    { title: 'LEARN', description: 'Structured learning paths, certifications and practical education.', icon: 'tabler:school', href: '/learn/' },
    { title: 'TOOLS', description: 'Useful digital tools and utilities, selected for practical work.', icon: 'tabler:tool', href: '/tools/' },
  ]} />
</Layout>
