---
import { getCollection } from 'astro:content';
import VebpartnerContentLayout from '~/layouts/VebpartnerContentLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
const entries = await getCollection('learn', ({ data }) => data.status === 'published' && !data.draft);
---
<VebpartnerContentLayout vertical="LEARN" title="Vebpartner Learn" description="Structured learning paths, certifications and practical educational resources." canonicalPath="/learn/" breadcrumbs={[{ label: 'Vebpartner', href: '/' }, { label: 'Learn' }]}><HeroText tagline="Vebpartner Learn" title="Learn skills with a clear path" subtitle="Structured learning paths, certifications and practical resources selected for real-world utility." /><section class="mx-auto max-w-5xl px-4 sm:px-6 pb-16">{entries.length === 0 ? <p class="rounded-2xl border border-dashed border-gray-300 p-8 text-center text-muted dark:border-slate-700">Curated LEARN resources are being prepared.</p> : <ul>{entries.map(({ data }) => <li>{data.title}</li>)}</ul>}</section></VebpartnerContentLayout>
