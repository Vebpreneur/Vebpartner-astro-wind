---
import { getCollection } from 'astro:content';
import VebpartnerContentLayout from '~/layouts/VebpartnerContentLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
const entries = await getCollection('tools', ({ data }) => data.status === 'published' && !data.draft);
---
<VebpartnerContentLayout vertical="TOOLS" title="Vebpartner Tools" description="Useful digital tools and utilities selected for practical business and technical work." canonicalPath="/tools/" breadcrumbs={[{ label: 'Vebpartner', href: '/' }, { label: 'Tools' }]}><HeroText tagline="Vebpartner Tools" title="Useful tools, without the noise" subtitle="A practical collection of digital tools and utilities for business and technical work." /><section class="mx-auto max-w-5xl px-4 sm:px-6 pb-16">{entries.length === 0 ? <p class="rounded-2xl border border-dashed border-gray-300 p-8 text-center text-muted dark:border-slate-700">Curated TOOLS resources are being prepared.</p> : <ul>{entries.map(({ data }) => <li>{data.title}</li>)}</ul>}</section></VebpartnerContentLayout>
