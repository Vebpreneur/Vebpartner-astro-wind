---
import { getCollection } from 'astro:content';
import VebpartnerContentLayout from '~/layouts/VebpartnerContentLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
const entries = await getCollection('services', ({ data }) => data.status === 'published' && !data.draft);
---
<VebpartnerContentLayout vertical="SERVICES" title="Vebpartner Services" description="Service models, providers and infrastructure for delivering commercial digital services." canonicalPath="/services/" breadcrumbs={[{ label: 'Vebpartner', href: '/' }, { label: 'Services' }]}><HeroText tagline="Vebpartner Services" title="Deliver services with leverage" subtitle="Explore service models and provider infrastructure designed to reduce unnecessary operational complexity." /><section class="mx-auto max-w-5xl px-4 sm:px-6 pb-16">{entries.length === 0 ? <p class="rounded-2xl border border-dashed border-gray-300 p-8 text-center text-muted dark:border-slate-700">Curated SERVICES resources are being prepared.</p> : <ul>{entries.map(({ data }) => <li>{data.title}</li>)}</ul>}</section></VebpartnerContentLayout>
